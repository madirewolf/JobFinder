# Copy this file to .env and fill in values. Never commit .env.

# --- Required ---
DATABASE_URL=postgresql://jfb:jfb_dev@localhost:5432/jfb

# --- Required for Sprint 2+ (classification) ---
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5

# --- Optional ---
SENTRY_DSN=
RESEND_API_KEY=
RESEND_FROM=Job Finder Bot <onboarding@resend.dev>
RESEND_TO=

# --- Optional ingestion keys ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# --- HTTP + logging ---
HTTP_TIMEOUT_S=30
HTTP_USER_AGENT=job-finder-bot/0.1 (personal use)
LOG_LEVEL=INFO
LOG_FORMAT=console  # or 'json'
